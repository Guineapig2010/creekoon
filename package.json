{
  "name": "creek-rolling-tycoon",
  "version": "1.0.0",
  "private": true,
  "description": "Make tennis balls, roll them down a creek, build a factory.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --minify --sourcemap --outfile=dist/game.js",
